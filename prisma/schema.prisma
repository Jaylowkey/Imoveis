generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("IMOVEIS_DATABASE_URL")
}

enum UserRole {
  CLIENT
  OWNER
  AGENT
  AGENCY
  ADMIN
}

enum PropertyPurpose {
  SALE
  RENT
}

enum PropertyCategory {
  HOUSE
  APARTMENT
  LAND
  COMMERCIAL
}

enum PropertyStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

model User {
  id          String     @id @default(cuid())
  name        String?
  email       String     @unique
  phone       String?
  role        UserRole   @default(CLIENT)
  properties  Property[]
  favorites   Favorite[]
  inquiries   Inquiry[]
  visits      Visit[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Property {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  purpose     PropertyPurpose
  category    PropertyCategory
  status      PropertyStatus   @default(PENDING)
  price       Decimal          @db.Decimal(14, 2)
  city        String
  location    String
  area        Int
  bedrooms    Int?
  bathrooms   Int?
  description String
  features    String[]         @default([])
  image       String?
  ownerId     String
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  favorites   Favorite[]
  inquiries   Inquiry[]
  visits      Visit[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, purpose, category])
  @@index([city, location])
  @@index([ownerId])
}

model Favorite {
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, propertyId])
}

model Inquiry {
  id         String   @id @default(cuid())
  propertyId String
  userId     String?
  name       String
  email      String?
  phone      String?
  message    String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([propertyId, createdAt])
}

model Visit {
  id         String   @id @default(cuid())
  propertyId String
  userId     String?
  name       String
  phone      String
  date       DateTime
  notes      String?
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([propertyId, date])
}
